{
    "name": "ernestdefoe/slow-mail",
    "description": "Slow Mail: pen-pal letters between members that take time to arrive, depending on how far apart they live. Stamps, postmarks, an outbox with each letter's journey, an inbox of envelopes to open, and pen-pal matching.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "letters",
        "pen pals",
        "slow mail",
        "community"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/slow-mail",
    "support": {
        "issues": "https://github.com/ernestdefoe/slow-mail/issues",
        "source": "https://github.com/ernestdefoe/slow-mail"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-sodium": "*",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\SlowMail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\SlowMail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Slow Mail",
            "category": "feature",
            "icon": {
                "name": "fas fa-envelope",
                "backgroundColor": "#b45309",
                "color": "#fff"
            },
            "optional-dependencies": [
                "ernestdefoe/member-map",
                "flarum/gdpr",
                "flarum/messages",
                "fof/byobu"
            ]
        }
    },
    "require-dev": {
        "ernestdefoe/member-map": "^1.0",
        "flarum/gdpr": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/suspend": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
